diff --git a/src/cart/overrides.c b/src/cart/overrides.c
--- a/src/cart/overrides.c
+++ b/src/cart/overrides.c
@@ -176,6 +176,36 @@ static void detectSaveLibrary(struct GBA* gba) {
 	}
 }
 
+// Reproduction cartridges carry SRAM in place of an EEPROM, and the images made for them have the
+// save library's EEPROM block read and write rewritten as copies to and from SRAM: the block number
+// times eight plus 0x0E000000, then an eight-byte loop. Such an image never uses the EEPROM its
+// game code is listed with, so it gets SRAM. The base is built in Thumb as "movs rN, #0xE0" then
+// "lsls rN, rN, #20", and the loop ends on "cmp rM, #7" a few instructions on; no game's own code
+// builds the SRAM address that way next to an eight-byte loop.
+static enum SavedataType eepromOrSram(struct GBA* gba, enum SavedataType type) {
+	if (type != SAVEDATA_EEPROM && type != SAVEDATA_EEPROM512) {
+		return type;
+	}
+	const uint8_t* rom = gba->rom;
+	for (uint32_t i = 0; i + 28 <= gba->romSize; i += 2) {
+		// movs rN, #0xE0 is 0x20E0 | N << 8; lsls rN, rN, #20 is 0x0500 | N << 3 | N.
+		if (rom[i] != 0xE0 || (rom[i + 1] & 0xF8) != 0x20) {
+			continue;
+		}
+		unsigned reg = rom[i + 1] & 7;
+		if ((unsigned) (rom[i + 2] | rom[i + 3] << 8) != (0x0500 | reg << 3 | reg)) {
+			continue;
+		}
+		for (uint32_t k = i + 4; k < i + 28; k += 2) {
+			// cmp rM, #7
+			if (rom[k] == 0x07 && (rom[k + 1] & 0xF8) == 0x28) {
+				return SAVEDATA_SRAM;
+			}
+		}
+	}
+	return type;
+}
+
 // Returns the hardware flags to emulate.
 int overridesApply(struct GBA* gba) {
 	const char* rom = (const char*) gba->rom;
@@ -207,7 +237,7 @@ int overridesApply(struct GBA* gba) {
 	for (size_t i = 0; i < sizeof(overrides) / sizeof(*overrides); ++i) {
 		if (!memcmp(overrides[i].id, &rom[0xAC], 4)) {
 			if (overrides[i].savetype != SAVEDATA_AUTODETECT) {
-				savedataForceType(gba, overrides[i].savetype);
+				savedataForceType(gba, eepromOrSram(gba, overrides[i].savetype));
 			} else {
 				detectSaveLibrary(gba);
 			}
@@ -216,7 +246,7 @@ int overridesApply(struct GBA* gba) {
 	}
 	if (rom[0xAC] == 'F') {
 		// Classic NES Series.
-		savedataForceType(gba, SAVEDATA_EEPROM);
+		savedataForceType(gba, eepromOrSram(gba, SAVEDATA_EEPROM));
 	} else {
 		detectSaveLibrary(gba);
 	}
