--- a/src/cpu/jit.c
+++ b/src/cpu/jit.c
@@ -1809,6 +1809,30 @@
 			return;
 		}
 	}
+#ifdef ARMGBA_HOST_IDLE_TENURE
+	// With more loops nominated than there are heads, each nomination pushed out the newest head,
+	// which had skipped nothing yet, and both blocks were compiled again: in a busy scene, heads
+	// changed hands a hundred times a second and never lived long enough to be judged (armGBA-pico:
+	// Yoshi's Island, about 230 blocks a second compiled again for this alone). An empty slot is
+	// taken first; a held one only after its tenure. Loads going back put the frame back too, so
+	// the age counts either way.
+	int slot = -1;
+	for (int i = 0; i < IDLE_HEADS; ++i) {
+		int32_t age = (int32_t) (jit->frame - jit->idleHeads[i].since);
+		if (!jit->idleHeads[i].key) {
+			slot = i;
+			break;
+		}
+		if ((age >= IDLE_TENURE || age <= -IDLE_TENURE) && (slot < 0 || jit->idleHeads[i].skips < jit->idleHeads[slot].skips)) {
+			slot = i;
+		}
+	}
+	if (slot < 0) {
+		return;
+	}
+	uint32_t old = jit->idleHeads[slot].key;
+	jit->idleHeads[slot] = (typeof(jit->idleHeads[0])) { span->head, 0, 0, jit->frame };
+#else
 	int slot = 0;
 	for (int i = 1; i < IDLE_HEADS; ++i) {
 		if (jit->idleHeads[i].skips < jit->idleHeads[slot].skips) {
@@ -1817,6 +1841,7 @@
 	}
 	uint32_t old = jit->idleHeads[slot].key;
 	jit->idleHeads[slot] = (typeof(jit->idleHeads[0])) { span->head, 0, 0 };
+#endif
 	if (old) {
 		idleRecompile(jit, old);
 	}
