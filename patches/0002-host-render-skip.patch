--- a/src/video/render.c
+++ b/src/video/render.c
@@ -2295,6 +2295,12 @@
 	}
 }
 
+#ifdef ARMGBA_HOST_RENDER_SKIP
+// Set by the host for a frame it will not show. Not part of the machine (not in struct GBA), so
+// save states are the same with and without it.
+bool armgbaRenderSkip;
+#endif
+
 // Draws line y, unless nothing it shows has changed since it was last drawn.
 void renderScanline(struct GBA* gba, int y) {
 	struct Renderer* renderer = &gba->renderer;
@@ -2370,6 +2376,15 @@
 	if (!dirty && !renderer->stereoChanges) {
 		return;
 	}
+#ifdef ARMGBA_HOST_RENDER_SKIP
+	// A host that will not show this frame (fast forward, run ahead) skips the drawing but keeps
+	// all the bookkeeping above: the line stays dirty, so the first frame drawn again redraws it,
+	// and a line that did not change keeps its pixels, as it would anyway (armGBA-pico).
+	if (armgbaRenderSkip) {
+		DIRTY_SCANLINE(renderer, y);
+		return;
+	}
+#endif
 	CLEAN_SCANLINE(renderer, y);
 
 	uint16_t* out = renderer->frame[y];
