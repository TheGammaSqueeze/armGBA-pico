+	extern uint8_t* armgbaHostRomBuffer(const void* data, size_t size);
+	gba->rom = armgbaHostRomBuffer(data, size);
+	if (!gba->rom) {
+		return false;
+	}
+#else
 #if defined(__3DS__)
 	// A frontend short on memory can hand over a zeroed SIZE_ROM buffer holding the game (gbaOfferRom),
